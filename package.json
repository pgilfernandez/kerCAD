{
  "name": "kercad-parametric",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "copy:occt": "node scripts/copy-occt-wasm.mjs",
    "predev": "npm run i18n && npm run copy:occt",
    "dev": "node scripts/dev.mjs",
    "prebuild": "npm run i18n && npm run copy:occt",
    "build": "next build apps/web",
    "export": "set STATIC_EXPORT=true&& next build apps/web && node scripts/verify-static-worker-assets.mjs",
    "verify:static-worker-assets": "node scripts/verify-static-worker-assets.mjs",
    "start": "next start apps/web",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:e2e": "vitest run --config tests/vitest.e2e.config.ts",
    "test:browser": "playwright test",
    "perf": "vitest run --config tests/vitest.perf.config.ts --reporter verbose",
    "perf:parametric": "vitest run --config tests/vitest.perf.config.ts tests/perf/parametric-classroom.perf.ts --reporter verbose",
    "ci": "npm run typecheck && npm run test",
    "docker:build": "node scripts/docker.mjs build",
    "docker:run": "docker run --rm -p 3000:3000 -v sketchforge-shared-projects:/data/projects -v kercad-challenges:/data/challenges:ro kercad:local",
    "docker:up": "node scripts/docker.mjs up",
    "docker:down": "docker compose -f deploy/docker/compose.yaml down",
    "mcp:sketchforge": "node scripts/sketchforge-mcp-server.mjs",
    "i18n": "node scripts/i18n.mjs",
    "pretest": "npm run i18n",
    "i18n:add": "node scripts/add-locale.mjs",
    "pretypecheck": "npm run i18n",
    "preexport": "npm run i18n && npm run copy:occt"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.8",
    "@types/three": "^0.184.1",
    "brepjs": "^18.118.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "lucide-react": "^0.511.0",
    "manifold-3d": "^3.5.0",
    "next": "^15.5.28",
    "occt-wasm": "file:vendor/occt-wasm-shell/occt-wasm-3.6.1+kercad.1.tgz",
    "react": "^19.1.0",
    "react-colorful": "^5.8.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.8",
    "three": "^0.184.0",
    "three-bvh-csg": "^0.0.18",
    "three-mesh-bvh": "^0.9.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "typescript": "^5.8.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "sharp": "0.35.5"
  }
}
