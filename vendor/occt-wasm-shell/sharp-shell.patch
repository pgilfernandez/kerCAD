+EvolutionData OcctKernel::shellSharpWithHistory(uint32_t solidId, std::vector<uint32_t> faceIds, double thickness, double tolerance, std::vector<int> inputFaceHashes, int hashUpperBound) {
+    try {
+        const auto& solid = get(solidId);
+        NCollection_List<TopoDS_Shape> facesToRemove;
+        for (uint32_t fid : faceIds) {
+            facesToRemove.Append(get(fid));
+        }
+        BRepOffsetAPI_MakeThickSolid maker;
+        maker.MakeThickSolidByJoin(solid, facesToRemove, -thickness, tolerance, BRepOffset_Skin, false, false, GeomAbs_Intersection);
+        maker.Build();
+        if (!maker.IsDone()) {
+            throw std::runtime_error("shellSharpWithHistory: operation failed");
+        }
+        uint32_t resultId = store(maker.Shape());
+        return buildEvolution(maker, resultId, solid, inputFaceHashes, hashUpperBound);
+    } catch (const Standard_Failure& e) {
+        throw std::runtime_error(std::string("shellSharpWithHistory: ") + e.what());
+    }
+}
