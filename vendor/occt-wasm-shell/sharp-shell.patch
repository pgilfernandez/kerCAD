+uint32_t OcctKernel::shellSharp(uint32_t solidId, std::vector<uint32_t> faceIds, double thickness, double tolerance) {
+    try {
+        NCollection_List<TopoDS_Shape> facesToRemove;
+        for (uint32_t fid : faceIds) {
+            facesToRemove.Append(get(fid));
+        }
+        BRepOffsetAPI_MakeThickSolid maker;
+        maker.MakeThickSolidByJoin(get(solidId), facesToRemove, -thickness, tolerance, BRepOffset_Skin, false, false, GeomAbs_Intersection);
+        maker.Build();
+        if (!maker.IsDone()) {
+            throw std::runtime_error("shellSharp: operation failed");
+        }
+        return store(maker.Shape());
+    } catch (const Standard_Failure& e) {
+        throw std::runtime_error(std::string("shellSharp: ") + e.what());
+    }
+}
